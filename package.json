{
  "name": "crypto-price-viewer",
  "displayName": "Crypto Price Viewer",
  "description": "Real-time cryptocurrency price viewer with market data, supply info, watchlist, price alerts, and lock-up details. Support multiple data sources, currencies, and automatic failover.",
  "publisher": "volcanic",
  "repository": {
    "type": "git",
    "url": "https://github.com/volcanicll/crypto-price-viewer.git"
  },
  "version": "3.0.0",
  "license": "MIT",
  "keywords": [
    "cryptocurrency",
    "crypto",
    "bitcoin",
    "ethereum",
    "price",
    "market",
    "trading",
    "finance",
    "blockchain",
    "token",
    "binance",
    "coingecko",
    "watchlist",
    "alerts"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "bugs": {
    "url": "https://github.com/volcanicll/crypto-price-viewer/issues"
  },
  "homepage": "https://github.com/volcanicll/crypto-price-viewer#readme",
  "categories": [
    "Other",
    "Data Science",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "resources/logo.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crypto-explorer",
          "title": "Crypto Price",
          "icon": "resources/crypto.svg"
        }
      ]
    },
    "views": {
      "crypto-explorer": [
        {
          "id": "cryptoPriceView",
          "name": "Crypto Prices",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "crypto-price-viewer.refresh",
        "title": "Refresh Prices",
        "icon": "$(refresh)"
      },
      {
        "command": "crypto-price-viewer.search",
        "title": "Search Coin",
        "icon": "$(search)"
      },
      {
        "command": "crypto-price-viewer.clearSearch",
        "title": "Clear Search",
        "icon": "$(clear-all)"
      },
      {
        "command": "crypto-price-viewer.sort.marketCap",
        "title": "Sort by Market Cap",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "crypto-price-viewer.sort.priceChange",
        "title": "Sort by 24h Change",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "crypto-price-viewer.toggleWatchlist",
        "title": "Add/Remove from Watchlist",
        "icon": "$(star-full)"
      },
      {
        "command": "crypto-price-viewer.setAlert",
        "title": "Set Price Alert",
        "icon": "$(bell)"
      },
      {
        "command": "crypto-price-viewer.manageAlerts",
        "title": "Manage Price Alerts",
        "icon": "$(bell)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "crypto-price-viewer.refresh",
          "when": "view == cryptoPriceView",
          "group": "navigation@1"
        },
        {
          "command": "crypto-price-viewer.search",
          "when": "view == cryptoPriceView",
          "group": "navigation@2"
        },
        {
          "command": "crypto-price-viewer.clearSearch",
          "when": "view == cryptoPriceView",
          "group": "navigation@3"
        },
        {
          "command": "crypto-price-viewer.sort.marketCap",
          "when": "view == cryptoPriceView",
          "group": "sort@1"
        },
        {
          "command": "crypto-price-viewer.sort.priceChange",
          "when": "view == cryptoPriceView",
          "group": "sort@2"
        }
      ],
      "view/item/context": [
        {
          "command": "crypto-price-viewer.showDetail",
          "when": "view == cryptoPriceView && viewItem =~ /cryptoItem/",
          "group": "inline@1"
        },
        {
          "command": "crypto-price-viewer.toggleWatchlist",
          "when": "view == cryptoPriceView && viewItem =~ /cryptoItem/",
          "group": "inline@2"
        },
        {
          "command": "crypto-price-viewer.setAlert",
          "when": "view == cryptoPriceView && viewItem =~ /cryptoItem/",
          "group": "actions@1"
        }
      ]
    },
    "configuration": {
      "title": "Crypto Price Viewer",
      "properties": {
        "cryptoPriceViewer.refreshInterval": {
          "type": "number",
          "default": 30,
          "description": "Auto-refresh interval in seconds (0 to disable)",
          "minimum": 0,
          "maximum": 3600
        },
        "cryptoPriceViewer.defaultLimit": {
          "type": "number",
          "default": 200,
          "enum": [
            100,
            200,
            500
          ],
          "enumDescriptions": [
            "Top 100 coins",
            "Top 200 coins",
            "Top 500 coins"
          ],
          "description": "Number of cryptocurrencies to display"
        },
        "cryptoPriceViewer.preferredDataSource": {
          "type": "string",
          "default": "CoinGecko",
          "enum": [
            "CoinGecko",
            "Binance"
          ],
          "description": "Preferred data source (fallback used automatically on failure)"
        },
        "cryptoPriceViewer.currency": {
          "type": "string",
          "default": "usd",
          "enum": [
            "usd",
            "eur",
            "cny",
            "jpy",
            "krw",
            "gbp"
          ],
          "enumDescriptions": [
            "US Dollar ($)",
            "Euro (€)",
            "Chinese Yuan (¥)",
            "Japanese Yen (¥)",
            "Korean Won (₩)",
            "British Pound (£)"
          ],
          "description": "Display currency for prices"
        },
        "cryptoPriceViewer.showSparkline": {
          "type": "boolean",
          "default": false,
          "description": "Show 7-day sparkline trend in tooltip (requires CoinGecko, increases data size)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "axios": "^1.6.2"
  }
}
